  "description": "React Native component for FusionCharts Javascript Charting Library",
  "license": "MIT",
  "scripts": {
    "clean:FC": "rimraf ./src/modules/fusioncharts",
    "copy:FC": "cp -r ./node_modules/fusioncharts ./src/modules/fusioncharts",
