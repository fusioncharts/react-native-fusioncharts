{
  "name": "react-native-fusioncharts",
  "version": "7.0.0",
  "description": "React Native component for FusionCharts Javascript Charting Library",
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "react-native",
    "fusioncharts",
    "charts",
    "graphs",
    "data-visualization",
    "expo",
    "android",
    "ios"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fusioncharts/react-native-fusioncharts.git"
  },
  "homepage": "https://github.com/fusioncharts/react-native-fusioncharts#readme",
  "bugs": {
    "url": "https://github.com/fusioncharts/react-native-fusioncharts/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "src/FusionCharts.js",
    "src/FusionCharts.d.ts",
    "src/FusionChartsModule.js",
    "src/modules/exportBridge.js",
    "src/modules/layout.js",
    "src/modules/modules.js",
    "src/modules/scripts.js",
    "src/utils/*.js",
    "licenses/fonts/*.txt",
    "docs/provenance/*.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:FC": "node ./scripts/build-fc.js",
    "test": "jest --runInBand --no-watchman",
    "verify:package": "node ./scripts/verify-package.js",
    "prepublishOnly": "npm run verify:package"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "react-native-share": "^12.3.1",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@dr.pogodin/react-native-fs": "2.40.0",
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "^0.87.0",
    "@react-native/jest-preset": "^0.87.0",
    "@testing-library/react-native": "^13.3.3",
    "babel-jest": "^29.7.0",
    "fusioncharts": "4.2.2",
    "jest": "^29.7.0",
    "react": "^19.2.8",
    "react-native": "^0.87.0",
    "react-test-renderer": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@dr.pogodin/react-native-fs": ">=2.28.1 <2.41.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.75.0 <0.88.0"
  },
  "overrides": {
    "brace-expansion": "^1.1.18",
    "dompurify": "^3.4.13",
    "js-yaml": "^3.15.2",
    "minimatch": "^3.1.4",
    "picomatch": "^2.3.2"
