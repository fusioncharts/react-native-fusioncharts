# Dependencies
node_modules/
**/vendor/bundle/

# Build output of this package
# src/modules/modules.js and scripts.js are generated by `npm run build:FC`
# but are committed deliberately: they are the shipped FusionCharts bundle.
coverage/
dist/
web-build/
*.tgz
*.tsbuildinfo

# Example application native build output.
# Regenerated by Gradle, CocoaPods, Bundler and Xcode. These were committed
# once before and added ~40k files to this repository; keep the examples to
# source and native project configuration only.
**/android/build/
**/android/app/build/
**/android/.gradle/
**/android/.cxx/
**/android/app/.cxx/
**/android/.kotlin/
**/android/local.properties
**/ios/build/
**/ios/Pods/
**/ios/DerivedData/

# Xcode and Android Studio per-developer state.
# Never commit these: the paths embed the developer's account name.
**/xcuserdata/
*.xcuserstate
.idea/
.vscode/

# Expo
**/.expo/
**/.expo-shared/

# Logs and debug output
*.log
npm-debug.*
yarn-error.log
.matrix-export/

# Credentials and signing material
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
.env
.env.*

# Editor and OS noise
*.orig.*
.DS_Store
Thumbs.db
